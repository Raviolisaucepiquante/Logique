# Copie ce fichier en « .env.local » (ignoré par Git) et remplis les deux valeurs
# trouvées dans Supabase : Project Settings > API (ou « Connect »).
# Ce sont l'adresse du projet et la clé PUBLIQUE (anon / publishable), protégée par les règles RLS.
# N'utilise JAMAIS la clé « service_role » / « secret » ici.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
