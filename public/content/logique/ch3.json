          "solution": [{ "d": 1, "f": "¬p", "r": "Hyp" }, { "d": 1, "f": "⊥", "r": "¬E", "c": "1, 2" }, { "d": 0, "f": "¬¬p", "r": "¬I", "c": "2-3" }]
