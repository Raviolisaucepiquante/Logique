          "solution": [{ "d": 1, "f": "p", "r": "Hyp" }, { "d": 1, "f": "q", "r": "→E", "c": "1, 3" }, { "d": 1, "f": "⊥", "r": "¬E", "c": "4, 2" }, { "d": 0, "f": "¬p", "r": "¬I", "c": "3-5" }],
