          "solution": [{ "d": 1, "f": "p", "r": "Hyp" }, { "d": 1, "f": "q ∨ p", "r": "∨I", "c": "2" }, { "d": 1, "f": "q", "r": "Hyp" }, { "d": 1, "f": "q ∨ p", "r": "∨I", "c": "4" }, { "d": 0, "f": "q ∨ p", "r": "∨E", "c": "1, 2-3, 4-5" }]
        },
        {
          "id": "c3-20",
